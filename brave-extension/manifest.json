{
    "manifest_version": 3,
    "name": "AniEvo Brave Bridge",
    "version": "2.5.0",
    "description": "Bridge lokal buat kontrol Brave yang lagi jalan (tanpa close/relaunch). Konek via WebSocket ke ws://127.0.0.1:8787 (cuma localhost).",
    "minimum_chrome_version": "116",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "tabs",
        "tabGroups",
        "scripting",
        "alarms",
        "debugger",
        "webNavigation"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "AniEvo Brave Bridge",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        }
    }
}
