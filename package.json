{
  "name": "anievo-brave-bridge",
  "version": "2.6.0",
  "description": "Control a running Brave/Chromium browser (without closing or relaunching) via an MV3 extension, zero-dependency CLI, and MCP server.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "brave",
    "chromium",
    "browser-automation",
    "mcp",
    "mcp-server",
    "ai-agent",
    "antigravity-plugin",
    "chrome-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AniEvo-ID/anievo-brave-bridge.git"
  },
  "files": [
    "brave-bridge.mjs",
    "mcp.mjs",
    "plugin.json",
    "mcp_config.json",
    "brave-extension/",
    "rules/",
    "skills/",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "bin": {
    "brave-bridge": "./brave-bridge.mjs",
    "brave-bridge-mcp": "./mcp.mjs"
  },
  "scripts": {
    "serve": "node brave-bridge.mjs serve",
    "mcp": "node mcp.mjs",
    "test": "node --test test/bridge.test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
